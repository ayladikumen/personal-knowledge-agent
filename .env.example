# Required — from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Required — from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — where notes are written. Relative paths resolve from the project root.
OBSIDIAN_VAULT_PATH=./vault

# Optional — where the embeddings index lives.
DATA_PATH=./data

# Optional — any model your API key can access.
GEMINI_MODEL=gemini-2.0-flash

# Optional — the embedding model used for search. Google retires these on its
# own schedule; if the configured one 404s, the known alternatives are tried.
GEMINI_EMBED_MODEL=gemini-embedding-001

# Optional — a GitHub token (no scopes needed for public repos). Without one,
# repo links share a 60-requests-per-hour budget with everyone on your IP.
GITHUB_TOKEN=

# Optional — set to false to stop falling back to the Internet Archive when a
# page can't be read directly.
LINK_ARCHIVE_FALLBACK=true
