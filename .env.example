# Required — from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Required — from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — where notes are written. Relative paths resolve from the project root.
OBSIDIAN_VAULT_PATH=./vault

# Optional — where the embeddings index lives.
DATA_PATH=./data

# Optional — any model your API key can access.
GEMINI_MODEL=gemini-2.0-flash
