# Required — from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Required — from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — where notes.db lives. Relative paths resolve from the project root.
DATA_PATH=./data

# Optional — the markdown import/export directory. Notes are stored in
# notes.db; this is only used by the export_markdown and import_markdown tools.
OBSIDIAN_VAULT_PATH=./vault

# Optional — any model your API key can access.
GEMINI_MODEL=gemini-2.0-flash

# Optional — embedding model for semantic search. Changing it makes every
# stored vector unusable; run reindex_notes afterwards to rebuild them.
GEMINI_EMBED_MODEL=gemini-embedding-2
